<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#15112A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="36dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/header_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <FrameLayout
            android:id="@+id/preview_frame"
            android:layout_width="312dp"
            android:layout_height="312dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/pixel_frame"
            android:padding="6dp">

            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/preview_bubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bubble_bg"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="11dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="5dp"
                    android:textColor="#3B2A3A"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="9dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="-1.5dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/bubble_tail" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/pixel_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/header_mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/mood_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:textColor="#FFF3E0"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mood_line"
                style="@style/PixelBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:id="@+id/stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/header_guests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp" />

        <TextView
            style="@style/PixelBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ajak temanmu mampir! Mereka duduk di kursi merah dan muncul di widget."
            android:textColor="#A898C8"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/guest_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btn_add_guest"
            style="@style/PixelButton"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_pink" />

        <LinearLayout
            android:id="@+id/header_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp" />

        <TextView
            style="@style/PixelBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Coba lihat semua mood, waktu, dan cuaca."
            android:textColor="#A898C8"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/mood_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/phase_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/weather_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/header_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp" />

        <Button
            android:id="@+id/btn_permission"
            style="@style/PixelButton"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_cyan"
            android:text="Kasih izin baca screen time" />

        <Button
            android:id="@+id/btn_pin"
            style="@style/PixelButton"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_pink"
            android:text="Pasang widget ke Home Screen" />

        <TextView
            style="@style/PixelBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Widget update tiap ~15 menit. Ketuk widget buat refresh."
            android:textColor="#5A4A84"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
