<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#15112A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="36dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.yatai.widget.PixelTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:pixelColor="#6AE0FF"
            app:pixelSize="2.5"
            app:pixelText="Kedai ramen di HP kamu" />

        <FrameLayout
            android:layout_width="312dp"
            android:layout_height="312dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/pixel_frame"
            android:padding="6dp">

            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/pixel_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/header_mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.yatai.widget.PixelTextView
                android:id="@+id/mood_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:pixelColor="#FFF3E0"
                app:pixelSize="5" />

            <com.yatai.widget.PixelTextView
                android:id="@+id/mood_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:pixelColor="#E8D6BF"
                app:pixelSize="2.5" />

            <LinearLayout
                android:id="@+id/stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/header_guests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp" />

        <com.yatai.widget.PixelTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:pixelColor="#A898C8"
            app:pixelSize="2.5"
            app:pixelText="Ajak temanmu mampir. Mereka duduk di kursi merah dan muncul di widget." />

        <LinearLayout
            android:id="@+id/guest_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.yatai.widget.PixelButton
            android:id="@+id/btn_add_guest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_pink" />

        <LinearLayout
            android:id="@+id/header_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp" />

        <com.yatai.widget.PixelTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:pixelColor="#A898C8"
            app:pixelSize="2.5"
            app:pixelText="Coba lihat semua mood, waktu, dan cuaca." />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/mood_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/phase_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/weather_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/header_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp" />

        <com.yatai.widget.PixelButton
            android:id="@+id/btn_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_cyan"
            app:pixelText="Kasih izin baca screen time" />

        <com.yatai.widget.PixelButton
            android:id="@+id/btn_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_pink"
            app:pixelText="Pasang widget ke home screen" />

        <com.yatai.widget.PixelTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:pixelCentered="true"
            app:pixelColor="#5A4A84"
            app:pixelShadow="false"
            app:pixelSize="2"
            app:pixelText="Widget update tiap 15 menit. Ketuk widget buat refresh." />
    </LinearLayout>
</ScrollView>
